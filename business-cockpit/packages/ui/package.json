{
  "name": "@example/bc-ui",
  "version": "0.1.0-SNAPSHOT",
  "private": true,
  "description": "The cockpit user interface, a Vue single-page application",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "generate": "openapi-ts",
    "prebuild": "npm run generate && node ../../scripts/check-texts.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "test": "vitest run"
  },
  "dependencies": {
    "@example/bc-module-host": "0.1.0-SNAPSHOT",
    "@example/bc-module-kit": "0.1.0-SNAPSHOT",
    "@example/bc-theme": "0.1.0-SNAPSHOT",
    "@mdi/js": "7.4.47",
    "vue": "3.5.46",
    "vue-router": "4.6.4",
    "vuetify": "4.3.4"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@vitejs/plugin-vue": "6.0.11",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-vuetify": "2.1.3",
    "vitest": "5.1.1",
    "vue-tsc": "3.3.14"
  }
}

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "updateInternalDeps": false,
  "packageRules": [
    {
      "matchPackageNames": ["vue", "vue-tsc", "@vitejs/plugin-vue", "@vue/test-utils"],
      "groupName": "vue"
    },
    {
      "matchPackageNames": ["vuetify", "vite-plugin-vuetify"],
      "groupName": "vuetify"
    }
  ]
}

{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "angular-module": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/entries.ts",
            "index": false,
            "polyfills": [],
            "tsConfig": "tsconfig.json",
            "outputPath": { "base": "dist", "browser": "" },
            "outputHashing": "all",
            "namedChunks": true,
            "statsJson": true
          }
        }
      }
    }
  }
}
